# =========================================================
# MEMORYOS BACKEND — ENVIRONMENT VARIABLES REFERENCE
# This file is safe to commit. Do NOT put real values here.
# Copy to .env and fill in your credentials.
# =========================================================

APP_NAME=memoryos-backend
APP_ENV=development
SERVER_PORT=8080

# Supabase PostgreSQL connection (Transaction pooler recommended)
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Supabase project credentials
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# JWT
# JWT_ISSUER is usually https://<project-ref>.supabase.co/auth/v1
# JWT_SECRET is the Supabase JWT secret, not the service-role key.
JWT_ISSUER=
JWT_SECRET=

# AI providers (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Maps (optional)
MAPS_API_KEY=

# Storage
STORAGE_BUCKET=memory-media

# CORS
FRONTEND_URL=http://localhost:5173

# Email (optional)
RESEND_API_KEY=

# Logging
LOG_LEVEL=INFO
